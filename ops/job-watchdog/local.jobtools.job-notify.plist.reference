<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.jobtools.job-notify</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>${HOME}/Library/Application Support/job-watchdog/notify-send.sh</string>
	</array>
	<key>WatchPaths</key>
	<array>
		<string>${HOME}/Library/Application Support/job-watchdog/outbox</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>${HOME}/Library/Application Support/job-watchdog/notify.stderr.log</string>
</dict>
</plist>
