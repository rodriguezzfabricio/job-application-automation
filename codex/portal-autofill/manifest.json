{
  "manifest_version": 3,
  "name": "Job portal autofill",
  "version": "1.0.0",
  "action": {
    "default_title": "Fill the armed employer account form"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      }
    }
  },
  "background": {
    "service_worker": "worker.js"
  }
}
