#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${JOB_AUTOMATION_PRIVATE_ROOT:=$ROOT/stopgap-private}"
export JOB_AUTOMATION_PRIVATE_ROOT
cd "$ROOT"
PYTHON="${JOB_AUTOMATION_PYTHON:-$ROOT/stopgap-private/codex-venv/bin/python}"
if [ ! -x "$PYTHON" ]; then PYTHON=python3; fi
exec "$PYTHON" -m job_runtime.jr "$@"
